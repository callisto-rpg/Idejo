#!/bin/sh
# SPDX-FileCopyrightText: 2026 Mariano Pictet and contributors
# SPDX-License-Identifier: AGPL-3.0-only
#
# Command-line setup (AD-14) and recovery (AD-09). In the production bundle:
#
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env exec app bin/idejo-admin health
#
# or, when the app container is not running, `run --rm app` instead of `exec app`.
set -eu

caller_dir=$PWD
cd -P -- "$(dirname -- "$0")"

usage() {
  cat <<USAGE
Usage: bin/idejo-admin COMMAND

Commands:
  setup --name NAME --owner-email EMAIL [--registration open|invite|closed]
                                    set up a new server instead of the setup wizard;
                                    the owner gets an email with a link to choose a
                                    password (printed here when email cannot go out).
                                    Registration is open unless given
  reset-owner-password [USERNAME]   give an owner a new password and end their sessions
  backup                            make a backup now, in the backup directory
  restore FILE [--yes]              replace the database and uploads with a backup's
                                    (server stopped; FILE alone is looked for in the
                                    backup directory)
  health                            check the server, database, migrations, push keys,
                                    uploads and last backup
  delete-account --oidc-subject SUB delete the account linked to the OpenID Connect
                                    provider's subject (anonymised, as when a member
                                    deletes it); exit 2 when none is linked
  leave --oidc-subject SUB          that person leaves: sessions end, pushes and email
                                    summaries stop, the account stays; exit 2 when none
  stats                             print members, topics, messages and the database's
                                    and uploads' sizes as one line of JSON
  push-key                          print the public key browsers subscribe with
  rotate-push-keys [--yes]          make new push keys; every browser's push
                                    subscription ends
USAGE
}

# Inside the running server when there is one (so ended sessions are disconnected at once),
# else in a fresh VM that starts only the database connection.
run() {
  if ./idejo pid >/dev/null 2>&1; then
    exec ./idejo rpc "$1"
  else
    exec ./idejo eval "$1"
  fi
}

# Passes an argument to Elixir as a string literal, whatever it contains.
quote() {
  printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\"#]/\\&/g')"
}

case "${1:-}" in
  setup)
    shift
    name="" email="" registration="open"
    while [ $# -gt 0 ]; do
      if [ $# -lt 2 ]; then usage >&2; exit 64; fi
      case $1 in
        --name) name=$2 ;;
        --owner-email) email=$2 ;;
        --registration) registration=$2 ;;
        *) usage >&2; exit 64 ;;
      esac
      shift 2
    done
    if [ -z "$(printf '%s' "$name" | tr -d '[:space:]')" ]; then
      echo "setup: --name is required." >&2
      exit 64
    fi
    case $email in
      *@*) ;;
      *) echo "setup: --owner-email must be an email address." >&2; exit 64 ;;
    esac
    case $registration in
      open | invite | closed) ;;
      *) echo "setup: --registration must be open, invite or closed." >&2; exit 64 ;;
    esac
    run "Idejo.Release.setup(name: $(quote "$name"), owner_email: $(quote "$email"), registration: $(quote "$registration"))"
    ;;
  reset-owner-password)
    if [ $# -gt 2 ]; then usage >&2; exit 64; fi
    run "Idejo.Release.reset_owner_password($(quote "${2:-}"))"
    ;;
  backup)
    if [ $# -gt 1 ]; then usage >&2; exit 64; fi
    run "Idejo.Release.backup()"
    ;;
  restore)
    if [ $# -lt 2 ] || [ $# -gt 3 ] || { [ $# -eq 3 ] && [ "$3" != "--yes" ]; }; then
      usage >&2
      exit 64
    fi
    if ./idejo pid >/dev/null 2>&1; then
      echo "Stop the server before restoring." >&2
      exit 1
    fi
    file=$2
    case $file in
      /*) ;;
      */*) file="$caller_dir/$file" ;;
    esac
    if [ $# -eq 2 ]; then
      echo "This replaces the database and the uploaded files with those of $2."
      echo "What is there now is backed up first."
      printf 'Type "restore" to go on: '
      read -r answer || answer=
      if [ "$answer" != "restore" ]; then echo "Nothing changed."; exit 1; fi
    fi
    exec ./idejo eval "Idejo.Release.restore($(quote "$file"))"
    ;;
  health)
    if [ $# -gt 1 ]; then usage >&2; exit 64; fi
    run "Idejo.Release.health()"
    ;;
  delete-account | leave)
    if [ $# -ne 3 ] || [ "$2" != "--oidc-subject" ] || [ -z "$3" ]; then usage >&2; exit 64; fi
    fun=$(printf '%s' "$1" | tr '-' '_')
    run "Idejo.Release.$fun($(quote "$3"))"
    ;;
  stats)
    if [ $# -gt 1 ]; then usage >&2; exit 64; fi
    run "Idejo.Release.stats()"
    ;;
  push-key)
    if [ $# -gt 1 ]; then usage >&2; exit 64; fi
    run "Idejo.Release.push_key()"
    ;;
  rotate-push-keys)
    if [ $# -gt 2 ] || { [ $# -eq 2 ] && [ "$2" != "--yes" ]; }; then usage >&2; exit 64; fi
    if [ $# -eq 1 ]; then
      echo "This makes new push keys. Every browser's push subscription ends; each"
      echo "subscribes again the next time its member opens a page."
      printf 'Type "rotate" to go on: '
      read -r answer || answer=
      if [ "$answer" != "rotate" ]; then echo "Nothing changed."; exit 1; fi
    fi
    run "Idejo.Release.rotate_push_keys()"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac
