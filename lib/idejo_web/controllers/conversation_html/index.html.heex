  SPDX-License-Identifier: AGPL-3.0-only
--%>
<Layouts.app flash={@flash} current_scope={@current_scope} width={:wide} conversation={:list}>
  <%!-- The inbox's Chats tab (steward request, 2026-11-10). --%>
  <Layouts.inbox_tabs :if={Idejo.Inbox.on?()} current={:chats} />
  <header :if={!Idejo.Inbox.on?()} class="page-intro">
    <h1>{gettext("Private Conversations")}</h1>
  </header>
  <h1 :if={Idejo.Inbox.on?()} class="sr-only">{gettext("Chats")}</h1>

  <p :if={@conversations == []} id="no-conversations" class="empty-state">
    {gettext("No private conversations yet. Open someone's card and choose “Private Message”.")}
  </p>

  <ul :if={@conversations != []} id="conversations" class="category-grid">
    <li
      :for={%{topic: topic, others: others, last: last, unread: unread} <- @conversations}
      id={"conversation-#{topic.id}"}
      class="category-card conversation-card"
    >
      <div class="category-card-head">
        <IdejoWeb.UserComponents.avatar :for={other <- others} user={other} size={:medium} />
        <h2 class="conversation-card-name">
          <.link href={~p"/p/#{topic.id}"} class="category-card-link">
            {IdejoWeb.ConversationController.title(others)}
          </.link>
        </h2>
      </div>
      <p :if={last} class="category-card-description">
        <span class="font-medium">{last.author.display_name}:</span>
        {Idejo.Forum.excerpt(last)}
      </p>
      <p :if={!last} class="category-card-description">{gettext("No messages yet.")}</p>
      <p class="category-card-stats">
        <span :if={unread > 0} class="badge badge-sm badge-primary unread-marker">
          {ngettext("1 new", "%{count} new", unread)}
        </span>
        <TopicComponents.time_ago at={topic.last_activity_at} />
      </p>
    </li>
  </ul>

  <%!-- Conversations that stayed in a forum: someone there has no idejo ID. --%>
  <div :if={assigns[:remaining] not in [nil, []]} id="chats-remaining" class="empty-state">
    <p>
      {gettext("Some conversations stayed in their forum, with people who have no idejo ID:")}
    </p>
    <ul>
      <li :for={r <- @remaining}>
        <a href={r.url}>{r.name}</a>
        ({ngettext("1 conversation", "%{count} conversations", r.count)})
      </li>
    </ul>
  </div>
</Layouts.app>
