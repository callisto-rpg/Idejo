<Layouts.app flash={@flash} current_scope={@current_scope}>
  <header class="page-intro">
    <h1>{gettext("The Idejo app cannot sign in")}</h1>
  </header>
  <p id="app-authorize-error">{refusal(@reason)}</p>
</Layouts.app>
