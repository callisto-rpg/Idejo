--%>
<Layouts.app flash={@flash} current_scope={@current_scope} footer>
  <header class="page-intro page-intro-row help-intro">
    <h1>{gettext("Help")}</h1>
    <%!-- Steward decision, 2026-10-25: at the right of the title. --%>
    <div class="bubbles-toggle-row">
      <span id="help-bubbles-label">{gettext("Tutorial bubbles")}</span>
      <Layouts.bubbles_toggle labelled_by="help-bubbles-label" />
    </div>
  </header>
  <div class="help-page">
    <%!-- Also in the getting-started card (steward request, 2026-11-09). --%>
    <IdejoWeb.HelpComponents.sending id="help-send" />

    <section id="help-signs" aria-labelledby="help-signs-title">
      <h2 id="help-signs-title">{gettext("Links and suggestions")}</h2>
      <p>
        {gettext(
          "At the start of a word, these signs open a list of suggestions while you type: click one, or use the arrow keys and Enter (or Tab); Escape closes the list."
        )}
      </p>
      <dl class="help-list">
        <div>
          <dt><kbd>@</kbd>{gettext("username")}</dt>
          <dd>
            {gettext(
              "Mentions someone: they are notified and follow the topic, unless they unfollowed it."
            )}
          </dd>
        </div>
        <div>
          <dt><kbd>+</kbd>{gettext("role")}</dt>
          <dd>
            {gettext(
              "Notifies everyone with that role who can read the topic. Which roles you may tag is set by the administrators."
            )}
          </dd>
        </div>
        <div>
          <dt><kbd>#</kbd>{gettext("topic")}</dt>
          <dd>{gettext("Links to a topic; once sent, it reads the topic's title.")}</dd>
        </div>
        <div>
          <dt><kbd>/</kbd>{gettext("category")}</dt>
          <dd>{gettext("Links to a category.")}</dd>
        </div>
        <div>
          <dt><kbd>$</kbd>{gettext("tag")}</dt>
          <dd>{gettext("Links to the topics with that tag.")}</dd>
        </div>
        <div>
          <dt><kbd>!</kbd>{gettext("command")}</dt>
          <dd>
            {gettext("Runs a command, listed below. What you typed for it leaves the box.")}
          </dd>
        </div>
      </dl>
    </section>

    <section id="help-commands" aria-labelledby="help-commands-title">
      <h2 id="help-commands-title">{gettext("Commands")}</h2>
      <p>
        {gettext(
          "Type ! at the start of a word in the box under a topic, then pick a command. The list shows the ones you may use there."
        )}
      </p>
      <dl class="help-list">
        <div :for={command <- @commands} id={"help-command-#{command.name}"}>
          <dt><code>{command.label}</code></dt>
          <dd>{command.help}</dd>
        </div>
      </dl>
      <%!-- Plugins (steward request, 2026-11-08): those turned on on this server. --%>
      <h3 :if={@plugins != []} id="help-plugins-title">{gettext("Plugins on this server")}</h3>
      <p :if={@plugins != []}>
        {gettext("Administrators choose which roles may use each one.")}
      </p>
      <dl :if={@plugins != []} id="help-plugins" class="help-list">
        <div :for={plugin <- @plugins} id={"help-plugin-#{plugin.name}"}>
          <dt><code>{plugin.label}</code></dt>
          <dd>{plugin.help}</dd>
        </div>
      </dl>
    </section>

    <%!-- Steward decision, 2026-10-28. --%>
    <section id="help-spoilers" aria-labelledby="help-spoilers-title">
      <h2 id="help-spoilers-title">{gettext("Hiding part of a message")}</h2>
      <dl class="help-list">
        <div id="help-inline-spoiler">
          <dt><code>||{gettext("text")}||</code></dt>
          <dd>
            {gettext(
              "Hides those words until each reader clicks them (or selects them and presses Enter). Quotes, search results and notifications show (spoiler) instead. To hide the whole message, use !spoiler."
            )}
          </dd>
        </div>
      </dl>
    </section>

    <%!-- Last on the page (steward decision, 2026-10-28): every format, what to type and how it
         shows. --%>
    <section id="help-formatting" aria-labelledby="help-formatting-title">
      <h2 id="help-formatting-title">{gettext("Formatting text")}</h2>
      <p>
        {gettext(
          "Messages are written in Markdown: type these signs around or before your words. They show as below once sent; @, +, #, / and $ links are above."
        )}
      </p>
      <dl class="help-list help-formatting">
        <div :for={format <- @formatting} id={"help-format-#{format.id}"}>
          <dt><code class="help-syntax">{format.syntax}</code></dt>
          <dd>
            <span>{format.label}</span>
            <div :if={format.example} class="help-example">
              <MessageComponents.body html={format.example} />
            </div>
          </dd>
        </div>
      </dl>
    </section>
  </div>
</Layouts.app>
