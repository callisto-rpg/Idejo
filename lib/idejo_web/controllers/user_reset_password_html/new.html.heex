<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm">
    <div class="text-center">
      <.header>
        {gettext("Reset your password")}
        <:subtitle>{gettext("We will email you a link to choose a new password.")}</:subtitle>
      </.header>
    </div>

    <.form :let={f} for={@form} id="reset_password_form" action={~p"/users/reset-password"}>
      <.input
        field={f[:email]}
        type="email"
        label={gettext("Email")}
        autocomplete="username"
        spellcheck="false"
        required
        autofocus
      />
      <.button class="btn btn-primary w-full">{gettext("Send the link")}</.button>
    </.form>

    <p class="text-center mt-4">
      <.link href={~p"/users/sign-in"} class="link">{gettext("Back to sign in")}</.link>
    </p>
  </div>
</Layouts.app>
