<Layouts.app flash={@flash} current_scope={@current_scope} category={@category}>
  <header class={["page-intro page-intro-row category-intro", "cat-#{@category.id}"]}>
    <TopicComponents.category_mark category={@category} size={:large} />
    <div class="grow">
      <h1>{@category.name}</h1>
      <p :if={@category.description != ""}>{@category.description}</p>
    </div>
    <.link
      :if={@can_start?}
      href={~p"/c/#{@category.slug}/new"}
      id="new-topic"
      class="btn btn-primary"
    >
      <.icon name="hero-plus" class="size-4" />
      {gettext("New topic")}
    </.link>
  </header>

  <p :if={@topics == [] and @page == 1} id="no-topics" class="empty-state">
    {gettext("No topics yet.")}
  </p>

  <ol :if={@topics != []} id="topics" class="topic-list">
    <TopicComponents.topic_row :for={topic <- @topics} topic={topic} unread={@unread[topic.id]} />
  </ol>

  <nav :if={@page > 1 or @more?} aria-label={gettext("Pages")} class="pager">
    <.link :if={@page > 1} href={~p"/c/#{@category.slug}?page=#{@page - 1}"} class="btn btn-sm">
      {gettext("Previous page")}
    </.link>
    <.link :if={@more?} href={~p"/c/#{@category.slug}?page=#{@page + 1}"} class="btn btn-sm">
      {gettext("Next page")}
    </.link>
  </nav>
</Layouts.app>
