  SPDX-License-Identifier: AGPL-3.0-only
--%>
<Layouts.app flash={@flash} current_scope={@current_scope}>
  <header class="page-intro">
    <h1>{gettext("Filter by tag")}</h1>
    <p>
      {gettext(
        "Choose one or more tags: the topics carrying all of them (And) or any of them (Or) are listed."
      )}
    </p>
  </header>

  <p :if={@groups == []} id="no-tags" class="empty-state">{gettext("No tags yet.")}</p>

  <form :if={@groups != []} action={~p"/tags"} method="get" id="tag-filter" class="tag-filter">
    <%!-- Kept by "Show topics"; an Operator button, later in the form, overrides it. --%>
    <input type="hidden" name="op" value={@op} />
    <fieldset :for={{category, tags} <- @groups}>
      <legend>{if category, do: category.name, else: gettext("All categories")}</legend>
      <div class="tag-choices">
        <label :for={tag <- tags} class="tag-choice">
          <input
            type="checkbox"
            name="tags[]"
            value={tag.slug}
            checked={tag in @selected}
            class="checkbox checkbox-xs"
          />
          {tag.name}
        </label>
      </div>
    </fieldset>
    <%!-- "Show topics" comes first: Enter in the form presses it, not an Operator button. --%>
    <div class="tag-filter-actions">
      <button class="btn btn-primary btn-sm">{gettext("Show topics")}</button>
      <%!-- Styled as the View toggle (steward decision, 2026-10-24); submit buttons, so the
           ticked tags go with the choice, without JavaScript. --%>
      <div class="view-toggle" id="operator-toggle">
        <span class="view-toggle-label" id="operator-toggle-label">{gettext("Operator")}</span>
        <div role="group" aria-labelledby="operator-toggle-label" class="join">
          <button
            :for={{op, label} <- [and: gettext("And"), or: gettext("Or")]}
            name="op"
            value={op}
            id={"operator-#{op}"}
            aria-pressed={to_string(@op == op)}
            class={["btn btn-sm join-item", @op == op && "btn-primary"]}
          >
            {label}
          </button>
        </div>
      </div>
    </div>
  </form>

  <section :if={@selected != []} aria-labelledby="tagged-heading">
    <h2 id="tagged-heading" class="section-heading">
      {cond do
        length(@selected) == 1 -> gettext("Topics tagged")
        @op == :or -> gettext("Topics carrying any of these tags")
        true -> gettext("Topics carrying all of these tags")
      end}
    </h2>
    <TopicComponents.tag_list tags={@selected} class="mb-3" />
    <p :if={@topics == [] and @page == 1} id="no-tagged-topics" class="empty-state">
      {if @op == :or,
        do: gettext("No topics carry any of these tags."),
        else: gettext("No topics carry all these tags.")}
    </p>
    <ol :if={@topics != []} id="topics" class="topic-list">
      <TopicComponents.topic_row :for={topic <- @topics} topic={topic} category />
    </ol>
    <nav :if={@page > 1 or @more?} aria-label={gettext("Pages")} class="pager mt-4">
      <.link :if={@page > 1} href={page_path(@selected, @op, @page - 1)} class="btn btn-sm">
        {gettext("Previous page")}
      </.link>
      <.link :if={@more?} href={page_path(@selected, @op, @page + 1)} class="btn btn-sm">
        {gettext("Next page")}
      </.link>
    </nav>
  </section>
</Layouts.app>
