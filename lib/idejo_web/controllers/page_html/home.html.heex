  SPDX-License-Identifier: AGPL-3.0-only
--%>
<Layouts.app flash={@flash} current_scope={@current_scope} width={:wide}>
  <%!-- The header already shows the server's name; the page keeps its one h1 (AX-01) for
       screen readers only. --%>
  <h1 class="sr-only">{Layouts.server_name()}</h1>

  <%!-- A link to a topic or category the user may not view led here (steward decision,
       2026-10-24, `IdejoWeb.Unavailable`). Open without JavaScript, closed by its form;
       with it, `open_dialogs.js` makes it modal. --%>
  <dialog
    :if={kind = Phoenix.Flash.get(@flash, :unavailable)}
    id="topic-unavailable"
    class="modal"
    data-show-modal
    aria-labelledby="topic-unavailable-title"
    aria-describedby="topic-unavailable-text"
    open
  >
    <div class="modal-box">
      <h2 id="topic-unavailable-title" class="text-lg font-semibold">
        {gettext("Unavailable")}
      </h2>
      <p id="topic-unavailable-text" class="mt-2">{IdejoWeb.Unavailable.message(kind)}</p>
      <form method="dialog" class="modal-action">
        <button class="btn btn-primary btn-sm">{gettext("OK")}</button>
      </form>
    </div>
  </dialog>

  <%!-- Visitors who are not signed in (steward decision, 2026-10-24), until they continue
       without signing in (`GuestNoticeController`, a plain form). --%>
  <dialog
    :if={@guest_notice?}
    id="guest-notice"
    class="modal"
    aria-labelledby="guest-notice-title"
    aria-describedby="guest-notice-text"
    data-show-modal
    open
  >
    <div class="modal-box guest-notice">
      <Layouts.full_logo />
      <h2 id="guest-notice-title" class="guest-notice-title">
        {gettext("You are not signed in.")}
      </h2>
      <p id="guest-notice-text">
        {gettext("You will not be able to post and won't see any hidden categories.")}
      </p>
      <.form for={%{}} action={~p"/continue-as-guest"} id="guest-notice-continue">
        <button class="btn btn-ghost w-full">{gettext("Continue without signing in")}</button>
      </.form>
      <div class="guest-notice-account">
        <.link href={~p"/users/sign-in"} class="btn btn-primary">{gettext("Sign in")}</.link>
        <.link href={~p"/users/sign-up"} class="btn btn-primary">{gettext("Sign up")}</.link>
      </div>
    </div>
  </dialog>

  <p :if={@categories == []} id="no-categories" class="empty-state">
    {gettext("Nothing to read here yet.")}
  </p>

  <%!-- RP-03: one "Categories" section, or one per group (ungrouped last, as "Other"). --%>
  <div :if={@sections != []} class="category-sections">
    <section
      :for={{{group, summaries}, index} <- Enum.with_index(@sections)}
      aria-labelledby={"categories-heading-#{index}"}
    >
      <h2 id={"categories-heading-#{index}"} class="section-divider">
        {section_title(group, length(@sections))}
      </h2>
      <ul id={if index == 0, do: "categories", else: "categories-#{index}"} class="category-grid">
        <li
          :for={%{category: category} = summary <- summaries}
          id={"category-#{category.id}"}
          class={["category-card", "cat-#{category.id}"]}
        >
          <div class="category-card-head">
            <TopicComponents.category_mark category={category} size={:large} />
            <h3>
              <a href={~p"/c/#{category.slug}"} class="category-card-link">{category.name}</a>
            </h3>
          </div>
          <p :if={category.description != ""} class="category-card-description">
            {category.description}
          </p>
          <p class="category-card-stats">
            <span>
              <.icon name="hero-chat-bubble-left-right" class="size-4" />
              {ngettext("1 topic", "%{count} topics", summary.topics)}
            </span>
            <span :if={summary.last_activity_at}>
              <.icon name="hero-clock" class="size-4" />
              <TopicComponents.time_ago at={summary.last_activity_at} />
            </span>
          </p>
        </li>
      </ul>
    </section>
  </div>

  <section :if={@active_topics != []} aria-labelledby="active-heading" class="has-view-toggle">
    <h2 id="active-heading" class="section-divider">{gettext("Active topics")}</h2>
    <%!-- Beside the title of the cards it changes (steward decision, 2026-10-24). --%>
    <TopicComponents.view_toggle view={@view} path={~p"/"} />
    <ol id="active-topics" class="topic-list">
      <TopicComponents.topic_row
        :for={topic <- @active_topics}
        topic={topic}
        lead={:category}
        preview={@previews[topic.id]}
      />
    </ol>
  </section>
</Layouts.app>
