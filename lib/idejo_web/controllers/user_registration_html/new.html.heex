<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm">
    <div class="text-center">
      <.header>
        {gettext("Create an account")}
        <:subtitle>
          {gettext("Already have one?")}
          <.link href={~p"/users/sign-in"} class="font-semibold text-brand hover:underline">
            {gettext("Sign in")}
          </.link>
        </:subtitle>
      </.header>
    </div>

    <p :if={@invite_only?} class="alert alert-info my-4">
      {gettext("Joining is by invitation. Use the link or code you were given.")}
    </p>

    <.form :let={f} for={@changeset} action={~p"/users/sign-up"}>
      <.input
        :if={@invite_only?}
        field={f[:invite_code]}
        type="text"
        label={gettext("Invite code")}
        autocomplete="off"
        spellcheck="false"
        required
      />
      <.input
        field={f[:email]}
        type="email"
        label={gettext("Email")}
        autocomplete="email"
        spellcheck="false"
        required
        autofocus
      />
      <.input
        field={f[:username]}
        type="text"
        label={gettext("Username (for @mentions)")}
        autocomplete="username"
        spellcheck="false"
        required
      />
      <.input
        field={f[:display_name]}
        type="text"
        label={gettext("Display name")}
        autocomplete="name"
        required
      />
      <.input
        field={f[:password]}
        type="password"
        label={gettext("Password (at least 12 characters)")}
        autocomplete="new-password"
        required
      />

      <.button phx-disable-with={gettext("Creating account…")} class="btn btn-primary w-full">
        {gettext("Create account")}
      </.button>
    </.form>
  </div>
</Layouts.app>
