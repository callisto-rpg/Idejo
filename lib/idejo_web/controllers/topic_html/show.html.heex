  SPDX-License-Identifier: AGPL-3.0-only
--%>
<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  category={@topic.category}
  topic={@topic}
  push_banner={@push_banner?}
>
  <.header>
    <span id="topic-title" class="topic-title">{@topic.title}</span>
    <%!-- The title's pencil (steward decision, 2026-10-23), shown on hover or focus; for the
         starter and moderators. It opens the form below through `:target`, so it needs no
         JavaScript. --%>
    <a
      :if={@can_rename?}
      href="#rename-topic"
      id="rename-topic-link"
      class="title-edit"
      aria-label={gettext("Change the title")}
      title={gettext("Change the title")}
    >
      <.icon name="hero-pencil-square-micro" class="size-5" />
    </a>
    <:subtitle>
      <.link href={~p"/c/#{@topic.category.slug}"} class="topic-category">
        <TopicComponents.category_mark category={@topic.category} />
        {@topic.category.name}
      </.link>
      <span :if={@topic.state == "archived"} id="topic-archived" class="badge badge-sm ml-2">
        {gettext("Archived: read only")}
      </span>
      <span :if={@topic.state == "locked"} id="topic-locked" class="badge badge-sm ml-2">
        {gettext("Locked: read only")}
      </span>
      <span :if={@topic.pinned} id="topic-pinned" class="badge badge-sm ml-2">
        {gettext("Pinned")}
      </span>
      <span :if={@topic.autofollow} id="topic-autofollow" class="badge badge-sm ml-2">
        {gettext("Followed by everyone")}
      </span>
    </:subtitle>
    <:actions :if={@current_scope && @current_scope.user}>
      <.form
        :if={!@following?}
        for={%{}}
        action={~p"/t/#{@topic.id}/follow"}
        method="post"
        id="follow-form"
      >
        <button class="btn btn-sm">{gettext("Follow")}</button>
      </.form>
      <.form
        :if={@following?}
        for={%{}}
        action={~p"/t/#{@topic.id}/follow"}
        method="delete"
        id="unfollow-form"
      >
        <button class="btn btn-sm" aria-describedby="following-note">
          {gettext("Unfollow")}
        </button>
        <span id="following-note" class="sr-only">{gettext("You follow this topic.")}</span>
      </.form>
    </:actions>
  </.header>

  <.form
    :if={@can_rename?}
    for={%{}}
    action={~p"/t/#{@topic.id}/title"}
    method="post"
    id="rename-topic"
    class="rename-topic"
  >
    <label for="rename-topic-title" class="label mb-1">{gettext("Title")}</label>
    <div class="flex flex-wrap gap-2">
      <input
        id="rename-topic-title"
        name="title"
        type="text"
        value={@topic.title}
        maxlength="150"
        required
        class="input input-sm flex-1 min-w-48"
      />
      <button class="btn btn-sm btn-primary">{gettext("Save")}</button>
      <a href="#" class="btn btn-sm btn-ghost">{gettext("Cancel")}</a>
    </div>
  </.form>

  <%!-- TP-14: moderator tools, a plain form (no JavaScript needed); each action is logged. --%>
  <details :if={@can_moderate?} id="topic-moderation" class="panel-details">
    <summary>
      <.icon name="hero-shield-check" class="size-4" />{gettext("Moderate this topic")}
    </summary>
    <.form
      for={%{}}
      action={~p"/t/#{@topic.id}/moderate"}
      method="post"
      id="topic-moderation-form"
      class="mt-2 flex flex-wrap items-end gap-2"
    >
      <label class="grow">
        <span class="label mb-1">{gettext("Reason (shown in the moderation log)")}</span>
        <input type="text" name="reason" maxlength="500" class="input input-sm w-full" />
      </label>
      <button
        :if={@topic.state == "open"}
        name="action"
        value="lock"
        class="btn btn-sm"
      >
        {gettext("Lock")}
      </button>
      <button
        :if={@topic.state == "locked"}
        name="action"
        value="unlock"
        class="btn btn-sm"
      >
        {gettext("Unlock")}
      </button>
      <button :if={!@topic.pinned} name="action" value="pin" class="btn btn-sm">
        {gettext("Pin")}
      </button>
      <button :if={@topic.pinned} name="action" value="unpin" class="btn btn-sm">
        {gettext("Unpin")}
      </button>
      <%!-- TP-15: to a category the moderator also moderates. --%>
      <span :if={@move_targets != []} class="flex items-end gap-2">
        <span>
          <span id="move-target-label" class="label mb-1">{gettext("Move to")}</span>
          <.dropdown
            id="move-target"
            name="category_id"
            labelled_by="move-target-label"
            class="is-small"
            options={Enum.map(@move_targets, &{&1.name, &1.id})}
          />
        </span>
        <button name="action" value="move" class="btn btn-sm">{gettext("Move")}</button>
      </span>
      <%!-- Steward decision, 2026-10-23: read only, in the Archive. --%>
      <button
        :if={@topic.state != "archived"}
        name="action"
        value="archive"
        id="archive-topic"
        class="btn btn-sm"
      >
        <.icon name="hero-archive-box" class="size-4" />{gettext("Archive topic")}
      </button>
    </.form>
    <%!-- Steward decision, 2026-10-23: its own form, so the box must be ticked for it only. --%>
    <.form
      for={%{}}
      action={~p"/t/#{@topic.id}/moderate"}
      method="post"
      id="delete-topic-form"
      class="delete-topic"
    >
      <input type="hidden" name="action" value="delete" />
      <p class="delete-topic-title">{gettext("Permanently delete topic")}</p>
      <p id="delete-topic-help" class="text-sm opacity-70">
        {gettext(
          "The topic and all its messages go for good, for everyone: this cannot be undone. Archive it instead to keep it, read only."
        )}
      </p>
      <label class="grow">
        <span class="label mb-1">{gettext("Reason (shown in the moderation log)")}</span>
        <input type="text" name="reason" maxlength="500" class="input input-sm w-full" />
      </label>
      <label class="delete-topic-confirm">
        <input
          type="checkbox"
          name="confirm"
          value="yes"
          required
          class="checkbox checkbox-sm"
          aria-describedby="delete-topic-help"
        />
        {gettext("Yes, delete this topic and all its messages for good")}
      </label>
      <button id="delete-topic" class="btn btn-sm btn-error">
        <.icon name="hero-trash" class="size-4" />{gettext("Permanently delete topic")}
      </button>
    </.form>
  </details>

  <%!-- Followed by everyone (steward decision, 2026-10-23): owners and administrators. --%>
  <.form
    :if={@can_autofollow?}
    for={%{}}
    action={~p"/t/#{@topic.id}/autofollow"}
    method="post"
    id="autofollow-form"
    class="panel-details"
  >
    <input type="hidden" name="autofollow" value={to_string(!@topic.autofollow)} />
    <p id="autofollow-help" class="text-sm opacity-70">
      {if @topic.autofollow,
        do:
          gettext(
            "Everyone who may read this topic follows it, unless they unfollow it; visitors see it in their sidebar."
          ),
        else:
          gettext(
            "Make everyone who may read this topic follow it, members who join later too; they can still unfollow it."
          )}
    </p>
    <button class="btn btn-sm mt-2" aria-describedby="autofollow-help">
      {if @topic.autofollow,
        do: gettext("Stop making everyone follow it"),
        else: gettext("Make everyone follow it")}
    </button>
  </.form>

  <TopicComponents.tag_list tags={@topic.tags} class="topic-tags" />

  <%!-- TP-19: change the tags, a plain form (no JavaScript needed); logged like moderation. --%>
  <details :if={@can_tag? and @available_tags != []} id="topic-tags-editor" class="panel-details">
    <summary>
      <.icon name="hero-tag" class="size-4" />{gettext("Edit tags")}
    </summary>
    <.form
      for={%{}}
      action={~p"/t/#{@topic.id}/tags"}
      method="post"
      id="topic-tags-form"
      class="mt-2 space-y-2"
    >
      <fieldset>
        <legend class="label mb-1">{gettext("Tags (at least one)")}</legend>
        <input type="hidden" name="tag_ids[]" value="" />
        <div class="tag-choices">
          <label :for={tag <- @available_tags} class="tag-choice">
            <input
              type="checkbox"
              name="tag_ids[]"
              value={tag.id}
              checked={Enum.any?(@topic.tags, &(&1.id == tag.id))}
              class="checkbox checkbox-xs"
            />
            {tag.name}
          </label>
        </div>
      </fieldset>
      <div class="flex flex-wrap items-end gap-2">
        <label class="grow">
          <span class="label mb-1">{gettext("Reason (shown in the moderation log)")}</span>
          <input type="text" name="reason" maxlength="500" class="input input-sm w-full" />
        </label>
        <button class="btn btn-sm">{gettext("Save tags")}</button>
      </div>
    </.form>
  </details>

  <blockquote :if={@forked_from} id="forked-from" class="message-quote">
    <.link href={~p"/m/#{@forked_from.id}"} class="font-medium">
      {gettext("Continued from %{name} in “%{topic}”",
        name: @forked_from.author.display_name,
        topic: @forked_from.topic.title
      )}
    </.link>
    <span class="opacity-70">{Idejo.Forum.excerpt(@forked_from)}</span>
  </blockquote>

  {live_render(@conn, IdejoWeb.TopicLive,
    id: "topic-#{@topic.id}",
    session: %{
      "topic_id" => @topic.id,
      "reply_to_id" => @reply_to_id,
      "first_unread" => @first_unread
    }
  )}
</Layouts.app>
