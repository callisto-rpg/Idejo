  SPDX-License-Identifier: AGPL-3.0-only
--%>
<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    {@topic.title}
    <:subtitle>
      <.link href={~p"/c/#{@topic.category.slug}"} class="link">{@topic.category.name}</.link>
      <span :if={@topic.state == "archived"} id="topic-archived" class="badge badge-sm ml-2">
        {gettext("Archived: read only")}
      </span>
    </:subtitle>
    <:actions :if={@current_scope && @current_scope.user}>
      <.form
        :if={!@following?}
        for={%{}}
        action={~p"/t/#{@topic.id}/follow"}
        method="post"
        id="follow-form"
      >
        <button class="btn btn-sm">{gettext("Follow")}</button>
      </.form>
      <.form
        :if={@following?}
        for={%{}}
        action={~p"/t/#{@topic.id}/follow"}
        method="delete"
        id="unfollow-form"
      >
        <button class="btn btn-sm" aria-describedby="following-note">
          {gettext("Unfollow")}
        </button>
        <span id="following-note" class="sr-only">{gettext("You follow this topic.")}</span>
      </.form>
    </:actions>
  </.header>

  <blockquote :if={@forked_from} id="forked-from" class="border-l-2 border-base-300 pl-3 text-sm">
    <.link href={~p"/m/#{@forked_from.id}"} class="link">
      {gettext("Continued from %{name} in “%{topic}”",
        name: @forked_from.author.display_name,
        topic: @forked_from.topic.title
      )}
    </.link>
    <span class="opacity-70">{Idejo.Forum.excerpt(@forked_from)}</span>
  </blockquote>

  {live_render(@conn, IdejoWeb.TopicLive,
    id: "topic-#{@topic.id}",
    session: %{"topic_id" => @topic.id, "reply_to_id" => @reply_to_id}
  )}
</Layouts.app>
