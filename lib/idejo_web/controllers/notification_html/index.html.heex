<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    {gettext("Notifications")}
    <:actions :if={Enum.any?(@notifications, &is_nil(&1.read_at))}>
      <.form for={%{}} action={~p"/notifications/read"} method="post" id="read-all-form">
        <button class="btn btn-sm">{gettext("Mark all read")}</button>
      </.form>
    </:actions>
  </.header>

  <p :if={@notifications == [] and @page == 1} id="no-notifications">
    {gettext("No notifications yet.")}
  </p>

  <ol :if={@notifications != []} id="notifications" class="divide-y divide-base-300">
    <li
      :for={notification <- @notifications}
      id={"notification-#{notification.id}"}
      class={["py-3", notification.read_at && "opacity-70"]}
    >
      <.link
        href={~p"/notifications/#{notification.id}"}
        class={["link", is_nil(notification.read_at) && "font-semibold"]}
      >
        <span :if={is_nil(notification.read_at)} class="sr-only">{gettext("Unread:")}</span>
        {headline(notification)}
      </.link>
      <p class="text-sm opacity-70">
        {Idejo.Forum.excerpt(notification.message)} ·
        <time datetime={DateTime.to_iso8601(notification.updated_at)}>
          {Calendar.strftime(notification.updated_at, "%Y-%m-%d %H:%M UTC")}
        </time>
      </p>
    </li>
  </ol>

  <nav :if={@page > 1 or @more?} aria-label={gettext("Pages")} class="flex gap-4 mt-4">
    <.link :if={@page > 1} href={~p"/notifications?page=#{@page - 1}"} class="link">
      {gettext("Previous page")}
    </.link>
    <.link :if={@more?} href={~p"/notifications?page=#{@page + 1}"} class="link">
      {gettext("Next page")}
    </.link>
  </nav>
</Layouts.app>
