  SPDX-License-Identifier: AGPL-3.0-only
--%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <IdejoWeb.Layouts.page_title page_title={assigns[:page_title]} />
    <%!-- SE-04: public pages name their one address, so search engines index it once. --%>
    <link :if={assigns[:canonical_url]} rel="canonical" href={@canonical_url} />
    <%!-- The Idejo favicon (steward decision, 2026-10-24). --%>
    <link rel="icon" type="image/png" href={~p"/images/favicon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- The website theme, Admin → Settings (steward decision, 2026-10-24). --%>
    <IdejoWeb.Layouts.theme_colours nonce={assigns[:style_csp_nonce]} />
    <%!-- The server's own stylesheet, after Idejo's: Admin → Stylesheet. --%>
    <link
      rel="stylesheet"
      href={~p"/theme.css?v=#{IdejoWeb.ThemeController.version(Idejo.Settings.get(:custom_css))}"}
    />
    <IdejoWeb.Layouts.category_colours
      nonce={assigns[:style_csp_nonce]}
      user={assigns[:current_scope] && @current_scope.user}
    />
    <IdejoWeb.Layouts.role_colours nonce={assigns[:style_csp_nonce]} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script phx-track-static type="text/javascript" src={~p"/assets/js/theme.js"}>
    </script>
  </head>
  <body class="app-shell">
    <%!-- AX-01: the first stop of the keyboard skips the navigation. --%>
    <a
      href="#main"
      id="skip-link"
      class="skip-link"
    >
      {gettext("Skip to content")}
    </a>
    {@inner_content}
    <%!-- Live notifications: bubbles and the sidebar kept current (steward decision,
      2026-10-23). A LiveView of its own outside the page's main one, so live navigation
      keeps it. --%>
    {assigns[:current_scope] && @current_scope.user && live_render(@conn, IdejoWeb.NotifierLive)}
  </body>
</html>
