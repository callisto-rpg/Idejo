#
# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public address of the server. Its DNS record must point at this machine.
IDEJO_DOMAIN=forum.example.org

# Email for Let's Encrypt certificate notices.
ACME_EMAIL=admin@example.org

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
