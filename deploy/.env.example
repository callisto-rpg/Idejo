#
# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Every variable the app reads is listed here (AD-13); docs/deploying.md has the full table.

# Public address of the server. Its DNS record must point at this machine.
IDEJO_DOMAIN=forum.example.org

# Email for Let's Encrypt certificate notices.
ACME_EMAIL=admin@example.org

# Running modified code? The AGPL requires a "Source code" link to your exact source.
# Set this to where you publish it. Leave empty for an unmodified Idejo.
IDEJO_SOURCE_URL=

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Generate with: openssl rand -hex 32 (hex only: the password goes into a URL)
POSTGRES_PASSWORD=

# Optional: an SMTP server for the server's emails, used only while Admin → Email has no
# SMTP host saved. Once one is saved there, the panel's settings are used and these are not.
# Leave IDEJO_SMTP_HOST empty to set email up in the admin panel instead.
IDEJO_SMTP_HOST=
# 587 when empty.
IDEJO_SMTP_PORT=
# starttls, tls (TLS from the start) or none (a relay on the same machine or network only).
# When empty: tls on port 465, else starttls.
IDEJO_SMTP_SECURITY=
IDEJO_SMTP_USERNAME=
IDEJO_SMTP_PASSWORD=
# Sender address; when empty, the one in Admin → Email (noreply@IDEJO_DOMAIN by default).
IDEJO_SMTP_FROM=

# Optional (AC-09): sign-in through an OpenID Connect provider. All four together, or none
# (some without the others stop the app at boot). Redirect URI to register at the provider:
# https://IDEJO_DOMAIN/users/oidc/callback
IDEJO_OIDC_ISSUER=
IDEJO_OIDC_CLIENT_ID=
IDEJO_OIDC_CLIENT_SECRET=
# The button reads "Sign in with" and this.
IDEJO_OIDC_LABEL=
# on (when empty) or off: off hides password sign-in, sign-up and reset (owners and
# administrators keep a password sign-in). Off needs the provider above.
IDEJO_LOCAL_ACCOUNTS=
# Optional: where people without an account at the provider make one, linked under its
# button ("No … yet? Create one"), for a provider whose sign-in screen does not offer it.
IDEJO_OIDC_SIGN_UP_URL=
# Optional: the Idejo ID registry an administrator may connect this server to from
# Admin → Idejo ID, when the provider above is not set (default https://login.idejo.org;
# off hides it).
IDEJO_ID_REGISTRY_URL=

# Optional, for a forum among several sharing one sign-in: the forum's icon opens a menu of
# the member's other communities, asked of IDEJO_COMMUNITY_URL with the OpenID Connect
# client's credentials (needs the provider above), and "Find more forums", linking to
# IDEJO_COMMUNITY_DIRECTORY_URL. Unset: the icon is a link to the home page.
IDEJO_COMMUNITY_URL=
IDEJO_COMMUNITY_DIRECTORY_URL=
# The chat service, for such a group: where members linked to the provider keep their private
# conversations (the sidebar's "Private Conversations" and the user card lead there; their
# conversations here are copied there once asked). Needs IDEJO_COMMUNITY_URL and the provider.
# Unset: private conversations stay in this forum.
IDEJO_CHAT_URL=
# Where a member sees the topics they follow across the group: "All my topics" above the
# sidebar's Private Conversations, for members linked to the provider. Unset: no button.
IDEJO_TOPICS_URL=
# Inbox mode: this install is a group's inbox (each member's forums, followed topics and
# chats; no sidebar or categories of its own). Needs IDEJO_COMMUNITY_URL and the provider.
# on or off (default off).
IDEJO_INBOX=

# Optional: database connections the app keeps open (10 when empty).
POOL_SIZE=

# Optional (AD-16): the reverse proxies whose X-Forwarded-For, -Proto and -Host headers the
# app believes: IP addresses or CIDR ranges separated by commas, e.g. 10.0.0.5,fd00::/8.
# When empty, peers on a private network are believed, which covers the bundled Caddy and a
# proxy reaching the app through Docker. A malformed list stops the app at boot.
IDEJO_TRUSTED_PROXIES=

# Only with deploy/docker-compose.external-proxy.yml (no bundled Caddy): the address and
# port the app is published on for your proxy (127.0.0.1 and 4000 when empty).
IDEJO_BIND=
IDEJO_PORT=

# The bundled Compose file sets these for the app from the values above; set them yourself
# only when you run the image without it:
#
# PHX_HOST=forum.example.org          required: the public host name (from IDEJO_DOMAIN)
# PHX_SERVER=true                     start the web server
# PORT=4000                           port the app listens on
# DATABASE_URL=ecto://idejo:PASSWORD@db/idejo   (from POSTGRES_PASSWORD)
# IDEJO_UPLOADS_DIR=/data/uploads     uploaded images
# IDEJO_BACKUP_DIR=/data/backups      nightly backups
# IDEJO_PLUGINS_DIR=/data/uploads/plugins   plugin files (Admin → Plugins); delete one to remove it
# IDEJO_PG_BIN_DIR=                   where pg_dump and pg_restore are, when not on the PATH
# ECTO_IPV6=                          true or 1 to reach the database over IPv6
# DNS_CLUSTER_QUERY=                  DNS name for clustering several nodes (unused by Idejo)
