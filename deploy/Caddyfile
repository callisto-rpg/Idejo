# Automatic HTTPS (SP-01). Caddy obtains and renews certificates for IDEJO_DOMAIN.
# WebSockets (LiveView, live delivery) are proxied without extra configuration.
# Content security policy and other app headers are set by the app (SP-05).

{
	email {$ACME_EMAIL}
}

{$IDEJO_DOMAIN} {
	encode zstd gzip

	tls {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy app:4000
}
